# Build-time settings for the landing page (python build.py or docker build --build-arg).
# They are baked into the static HTML; nothing here is secret and nothing is read at runtime.
# Copy to .env for local use (ignored by git). In production, shared-landing passes them from
# envs/alondra1-www.env as ALONDRA1_* variables (see that repository's README).

# Canonical origin, https and no trailing slash.
SITE_URL=https://alondra1.com

# Existing Alondra1 sign-in pages. Leave empty until they exist: Log in, Register, and Create account stay hidden.
LOGIN_URL=
REGISTER_URL=

# Footer links, shown only when set.
PRIVACY_URL=
TERMS_URL=
CONTACT_URL=

# Google Tag Manager container id. Leave empty for local builds and CI so they send no analytics hits;
# production sets it through shared-landing (ALONDRA1_GTM_ID in envs/alondra1-www.env).
GTM_ID=
